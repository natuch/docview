@{
    ViewData["Title"] = "Viewer";
    var documentId = ViewData["DocumentId"];
    var displayName = ViewData["DisplayName"] as string ?? "Document";
}

@section Styles {
    <link rel="stylesheet" href="~/css/viewer.css" asp-append-version="true" />
}

<div id="viewer-root" class="pdf-viewer" data-document-id="@documentId" data-stream-url="/Viewer/@documentId/stream">
    <div class="toolbar">
        <div class="toolbar-group">
            <button id="btn-toggle-sidebar" type="button" title="แสดง/ซ่อนตัวอย่างหน้า" aria-pressed="true">&#9776;</button>
        </div>
        <div class="toolbar-group">
            <button id="btn-first" type="button" title="หน้าแรก">&#8676;</button>
            <button id="btn-prev" type="button" title="หน้าก่อนหน้า">&#8592;</button>
            <span class="page-indicator">
                <input id="page-input" type="number" min="1" value="1" />
                <span>/ <span id="page-count">-</span></span>
            </span>
            <button id="btn-next" type="button" title="หน้าถัดไป">&#8594;</button>
            <button id="btn-last" type="button" title="หน้าสุดท้าย">&#8677;</button>
        </div>
        <div class="toolbar-group toolbar-title" title="@displayName">@displayName</div>
        <div class="toolbar-group">
            <button id="btn-zoom-out" type="button" title="ย่อ">&#8722;</button>
            <span id="zoom-level">100%</span>
            <button id="btn-zoom-in" type="button" title="ขยาย">&#43;</button>
            <button id="btn-rotate" type="button" title="หมุน">&#8635;</button>
        </div>
    </div>
    <div class="viewer-body">
        <div id="thumbnail-panel" class="thumbnail-panel">
            <div id="thumbnail-list" class="thumbnail-list"></div>
        </div>
        <div id="canvas-container" class="canvas-container" oncontextmenu="return false;">
            <div id="pages-container" class="pages-container"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/viewer.js" asp-append-version="true"></script>
    <script src="~/js/protect.js" asp-append-version="true"></script>
}
