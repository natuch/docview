@{
    var documentId = ViewData["DocumentId"];
    var displayName = ViewData["DisplayName"] as string ?? "Document";
    ViewData["Title"] = $"Viewer - {displayName}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/viewer.css" asp-append-version="true" />
}

<div id="viewer-root" class="pdf-viewer" data-document-id="@documentId" data-stream-url="/Viewer/@documentId/stream" data-release-url="/Viewer/@documentId/release">
    <div class="toolbar">
        <div class="toolbar-group">
            <button id="btn-toggle-sidebar" type="button" class="icon-btn" title="แสดง/ซ่อนตัวอย่างหน้า" aria-pressed="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
            </button>
        </div>
        <div class="toolbar-group">
            <button id="btn-first" type="button" class="icon-btn" title="หน้าแรก">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="5" x2="6" y2="19" /><polyline points="18 5 9 12 18 19" /></svg>
            </button>
            <button id="btn-prev" type="button" class="icon-btn" title="หน้าก่อนหน้า">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 6 9 12 15 18" /></svg>
            </button>
            <span class="page-indicator">
                <input id="page-input" type="number" min="1" value="1" />
                <span>/ <span id="page-count">-</span></span>
            </span>
            <button id="btn-next" type="button" class="icon-btn" title="หน้าถัดไป">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18" /></svg>
            </button>
            <button id="btn-last" type="button" class="icon-btn" title="หน้าสุดท้าย">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="5" x2="18" y2="19" /><polyline points="6 5 15 12 6 19" /></svg>
            </button>
        </div>
        <div class="toolbar-group toolbar-title" title="@displayName">@displayName</div>
        <div class="toolbar-group">
            <button id="btn-zoom-out" type="button" class="icon-btn" title="ย่อ">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="15.5" y2="15.5" /><line x1="8" y1="11" x2="14" y2="11" /></svg>
            </button>
            <span id="zoom-level">100%</span>
            <button id="btn-zoom-in" type="button" class="icon-btn" title="ขยาย">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="15.5" y2="15.5" /><line x1="11" y1="8" x2="11" y2="14" /><line x1="8" y1="11" x2="14" y2="11" /></svg>
            </button>
            <button id="btn-rotate-left" type="button" class="icon-btn" title="หมุนทวนเข็มนาฬิกา">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /></svg>
            </button>
            <button id="btn-rotate-right" type="button" class="icon-btn" title="หมุนตามเข็มนาฬิกา">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" /><path d="M21 3v5h-5" /></svg>
            </button>
        </div>
    </div>
    <div class="viewer-body">
        <div id="thumbnail-panel" class="thumbnail-panel collapsed">
            <div id="thumbnail-list" class="thumbnail-list"></div>
        </div>
        <div id="canvas-container" class="canvas-container" oncontextmenu="return false;">
            <div id="pages-container" class="pages-container"></div>
        </div>
    </div>

    <div id="password-overlay" class="password-overlay hidden">
        <div class="password-dialog">
            <p id="password-message">เอกสารนี้มีการป้องกันด้วยรหัสผ่าน กรุณากรอกรหัสผ่านเพื่อเปิดดู</p>
            <input id="password-input" type="password" autocomplete="off" />
            <div class="password-actions">
                <button id="password-cancel" type="button">ยกเลิก</button>
                <button id="password-submit" type="button">เปิดเอกสาร</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/viewer.js" asp-append-version="true"></script>
    <script src="~/js/protect.js" asp-append-version="true"></script>
}
