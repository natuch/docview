{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LocalFileAccess": {
    // Required for HomeController.Index's ?file=&key= shortcut to work outside
    // Development. Deliberately left blank here (this file is committed to git) -
    // set the real value per-environment via the LocalFileAccess__SharedKey
    // environment variable (e.g. web.config's <environmentVariables> on IIS), never
    // by editing this checked-in file. An empty/missing key denies the endpoint.
    "SharedKey": ""
  }
}
