<?xml version="1.0" encoding="utf-8"?>
<!--
  Base template for the ASP.NET Core Module (ANCM) - %LAUNCHER_PATH% / %LAUNCHER_ARGS%
  are filled in by `dotnet publish`. The additions below are IIS-specific and would
  otherwise silently break things that work fine under Kestrel in dev:
    - requestLimits: IIS's own request-filtering module runs in front of ANCM and
      rejects oversized bodies before the request ever reaches the app, independent
      of the [RequestSizeLimit] attribute on HomeController.Upload. Must match (or
      exceed) that attribute's 500 MB, in bytes.
    - mimeMap for .mjs: IIS has no built-in MIME mapping for .mjs and can intercept
      the request with its own static file handler before it reaches the app's
      FileExtensionContentTypeProvider, serving pdf.js's ES module with the wrong
      content type (browsers refuse to execute it).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="524288000" />
        </requestFiltering>
      </security>
      <staticContent>
        <remove fileExtension=".mjs" />
        <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
